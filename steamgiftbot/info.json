{
    "URL"       : "https://www.steamgifts.com",
    "ajaxURL"   : "https://www.steamgifts.com/ajax.php",
    "http"      : "http://",
    "https"     : "https://",

    "timeout"               : 30,
    "pointsWaitSeconds"     : 900,

    "entryDelaySeconds"     : [3, 7],
    "rateLimitWaitSeconds"  : 60,

    "userAgent" : "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/102.0.0.0 Safari/537.36",

    "filterURL" : {
        "All"           : "search?page=%d",
        "WishList"      : "search?page=%d&type=wishlist",
        "Recommended"   : "search?page=%d&type=recommended",
        "Copies"        : "search?page=%d&copy_min=2",
        "DLC"           : "search?page=%d&dlc=true",
        "New"           : "search?page=%d&type=new"
    }
}
